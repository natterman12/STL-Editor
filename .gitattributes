# Vendored files (and the web edition's published copy of them) are checked against their SHA-256
# and against each other; keep them byte for byte on every checkout.
web/vendor/** -text
docs/app1/vendor/** -text
# docs/app is the 2.0 web edition as the Web preview (2.0) workflow built it, plus the Support
# Fins engine in docs/app/vendor/support-fins that installed apps download.
docs/app/** -text
rust/tests/** -text
rust/tests/parity/import2d/** -text
# The 2.0 licences page is written by `cargo run -p xtask -- licences` and built into the app;
# keep it as written, so the app is the same whichever system it was checked out on.
rust/crates/stl-app/assets/licences.html -text
# The 2.0 icon files are written by rust/crates/stl-app/assets/icon/make_icon.py; keep them as written.
*.rgba binary
*.icns binary
*.ico binary
# The 2.0 web preview is a build committed by the Web preview (2.0) workflow; keep it as built.
docs/app2/** -text
# Vendored crates are kept byte for byte. Their licence files are read into the 2.0 licences page:
# with Windows line ends cargo-about takes a text for a different one, and the page comes out
# unlike the one CI builds on Linux.
rust/third_party/** -text
